# Copier ce fichier en .env et le renseigner. Le fichier .env ne doit pas être commité.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
DB_NAME=account_memory

# --- Tokens JWT : au moins 32 caractères aléatoires ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Modèle de chat : n'importe quelle API compatible OpenAI (par défaut Gemma 4 sur Lightning AI) ---
LLM_BASE_URL=https://lightning.ai/api/v1/
LLM_API_KEY=
CHAT_MODEL=lightning-ai/gemma-4-31B-it

# --- Embeddings : Voyage AI ---
# Sans moyen de paiement sur le compte Voyage, l'API est limitée à 3 requêtes par minute :
# tout marche quand même, mais l'ingestion et les recherches attendent beaucoup.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-large

# --- Adresses des services quand on les lance à la main (docker compose met les siennes) ---
MCP_URL=http://localhost:8001/mcp
API_URL=http://localhost:8000

# --- Optionnel : vrai envoi d'emails. Sans SMTP_HOST, les emails approuvés vont dans "outbox". ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
